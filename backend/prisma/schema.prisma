generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

model User {
  /// Mirrors the UUID assigned by Supabase Auth (auth.users).
  id             String       @id @db.Uuid
  email          String       @db.VarChar(320)
  emailNormalized String      @unique @db.VarChar(320)
  status         UserStatus   @default(PENDING_VERIFICATION)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  memberships    Membership[]
  invitations    Invitation[] @relation("InvitationCreator")
  auditEvents    AuditEvent[] @relation("AuditActor")

  @@index([status, createdAt])
}

model Organization {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @db.VarChar(160)
  slug        String       @unique @db.VarChar(100)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)
  memberships Membership[]
  invitations Invitation[]
  auditEvents  AuditEvent[]

  @@index([createdAt])
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  organizationId String           @db.Uuid
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

model Invitation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  createdById    String       @db.Uuid
  emailNormalized String      @db.VarChar(320)
  tokenHash      String       @unique @db.VarChar(255)
  expiresAt      DateTime     @db.Timestamptz(3)
  acceptedAt     DateTime?    @db.Timestamptz(3)
  revokedAt      DateTime?    @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, emailNormalized])
  @@index([expiresAt])
}

model AuditEvent {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @db.Uuid
  actorUserId    String?       @db.Uuid
  action         String        @db.VarChar(120)
  targetType     String?       @db.VarChar(120)
  targetId       String?       @db.VarChar(160)
  metadata       Json?
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor          User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

# Local API configuration. Never put real credentials in this file.
NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:3000

# Public Supabase project URL used to validate access-token signatures.
SUPABASE_URL=https://your-project.supabase.co

# PostgreSQL connection: keep the real value private in Render, never in GitHub.
# Use the Supabase Session Pooler URI for the backend runtime.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
